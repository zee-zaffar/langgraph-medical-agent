# Copy this file to .env and fill in your values.

# --- OpenAI ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# --- PostgreSQL (LangGraph state persistence) ---
# Docker Compose injects this automatically for the backend container.
# Set it here for local development (running uvicorn outside Docker).
DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agentdb

# --- Twilio (outbound appointment calls) ---
# Sign up at https://twilio.com — free trial gives $15 credit.
# Buy a phone number (~$1/month) and copy your Account SID + Auth Token from the console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
