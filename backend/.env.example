# Copy this file to .env and fill in your values.

# --- OpenAI ---
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o

# --- PostgreSQL (LangGraph state persistence) ---
# Docker Compose injects this automatically for the backend container.
# Set it here for local development (running uvicorn outside Docker).
DATABASE_URL=postgresql://agent:agentpass@localhost:5432/agentdb
